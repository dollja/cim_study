{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIM study human reviews — requested reference keys",
  "description": "Current Tier S human review records using requested reference-draft field names. This preserves current evidence/support structures rather than importing the old annotation schema. Normalize with review_key_codec.py before validation, comparison or hashing. One local task question is recorded per case; additional selected quotations remain in focus.additional_quotes.",
  "type": "object",
  "patternProperties": {
    "^[A-Za-z0-9_]+$": {
      "$ref": "#/$defs/review"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "meaning": {
      "type": "object",
      "required": [
        "Participant",
        "Interpretation",
        "Evidence quotes",
        "Evidence support"
      ],
      "properties": {
        "Participant": {
          "type": "string",
          "minLength": 1
        },
        "Interpretation": {
          "type": "string",
          "minLength": 1
        },
        "Evidence quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_quote"
          }
        },
        "Evidence support": {
          "enum": [
            "supported",
            "possible",
            "unsupported",
            null
          ],
          "description": "Human assessment. Possible readings are not adopted readings. An exact quote alone does not prove support."
        },
        "Support note": {}
      },
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "participant_id",
            "meaning",
            "support",
            "source_quotes",
            "support_note"
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "Schema version",
        "Evidence tier",
        "Observer input SHA-256",
        "What had you seen before your first judgment?",
        "First prefix review completed",
        "Separate later-evidence review completed",
        "Draft wording fields",
        "I checked the content now entered against the available evidence."
      ],
      "properties": {
        "Schema version": {
          "const": "1.0"
        },
        "Evidence tier": {
          "const": "S"
        },
        "Observer input SHA-256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256 of the raw four-field observer_inputs JSON file, not the observer_cases wrapper."
        },
        "What had you seen before your first judgment?": {
          "type": "object",
          "required": [
            "Assistant drafts",
            "System predictions",
            "Released / other labels",
            "Later dialogue or outcomes",
            "Exposure notes"
          ],
          "properties": {
            "Assistant drafts": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "System predictions": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "Released / other labels": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "Later dialogue or outcomes": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "Exposure notes": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "propertyNames": {
            "not": {
              "enum": [
                "assistant_draft",
                "system_outputs",
                "released_labels",
                "later_evidence",
                "notes"
              ]
            }
          }
        },
        "First prefix review completed": {
          "type": "boolean"
        },
        "Separate later-evidence review completed": {
          "type": "boolean"
        },
        "Draft wording fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "I checked the content now entered against the available evidence.": {
          "type": "boolean",
          "description": "True only after a human checks the current content; importing wording does not confirm it."
        },
        "Saved first judgment": {
          "$ref": "#/$defs/review_snapshot",
          "description": "Optional first-pass substantive record. Decode all contextual keys to the technical convention before checking its existing SHA-256."
        },
        "Saved first judgment SHA-256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the technical-key snapshot after contextual decoding, recursively key-sorted compact JSON encoded as UTF-8. A key-only human-label conversion preserves this hash."
        },
        "Wording consultation history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Before first prefix judgment": {
                "type": "boolean"
              },
              "Time UTC": {},
              "Source file": {},
              "Action": {},
              "Fields": {}
            },
            "additionalProperties": true,
            "propertyNames": {
              "not": {
                "enum": [
                  "at_utc",
                  "source_filename",
                  "action",
                  "before_prefix_first_review",
                  "fields"
                ]
              }
            }
          },
          "description": "Append-only suggestion viewing/copy history. Later viewing requires an unchanged frozen first-pass snapshot to retain strict reference eligibility."
        },
        "Reference condition": {},
        "Preparation history record": {},
        "First judgment saved at UTC": {}
      },
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "assistant_wording_fields",
            "evidence_tier",
            "first_pass_judgment_sha256",
            "first_pass_judgment_snapshot",
            "first_pass_recorded_at_utc",
            "focus_selection_reason",
            "human_content_confirmed",
            "later_evidence_review_completed",
            "observer_input_sha256",
            "prefix_first_review_completed",
            "prior_exposure",
            "provenance_record",
            "reference_condition",
            "schema_version",
            "wording_exposure_events"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "Review status",
        "Reviewer",
        "Reviewer and exposure",
        "Participants being compared",
        "participant_interpretations",
        "consequence_analysis",
        "Could uncertainty change the conclusion?",
        "Review judgment",
        "rationale",
        "Evidence checked?",
        "Include in pilot?",
        "selection_reason",
        "subtask_hypotheses",
        "focus"
      ],
      "properties": {
        "Review status": {
          "enum": [
            "unreviewed",
            "in_progress",
            "reviewed",
            "completed"
          ]
        },
        "Reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "Reviewer and exposure": {
          "$ref": "#/$defs/metadata"
        },
        "Participants being compared": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "Could uncertainty change the conclusion?": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "Review judgment": {
          "enum": [
            "ALIGNED",
            "POTENTIAL_MISMATCH",
            "UNRESOLVED",
            null
          ]
        },
        "Evidence checked?": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "Include in pilot?": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "participant_interpretations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meaning"
          }
        },
        "consequence_analysis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "Evidence tier": {
                  "const": "S"
                },
                "Supported consequences JSON": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "array"
                  },
                  "description": "Optional canonical F6 values keyed by actual participant IDs, for the same task/event. The checker never infers these sets from prose."
                },
                "Same task / event scope": {},
                "Consequences by participant": {},
                "Comparison in words": {},
                "What is still unknown? One reason per line": {},
                "Evidence check notes": {},
                "Consequence format notes": {},
                "Implementation limits": {},
                "Computation status": {},
                "Preparation notes": {}
              },
              "additionalProperties": true,
              "propertyNames": {
                "not": {
                  "enum": [
                    "evidence_tier",
                    "scope",
                    "participant_outputs",
                    "comparison",
                    "blocking_reasons",
                    "supported_consequences",
                    "verification_note",
                    "consequence_encoding_note",
                    "implementation_limits",
                    "computation_status",
                    "authorship"
                  ]
                }
              }
            }
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtask_hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "description": "Exactly one current local task question; null description is a pending question. Multiple human task hypotheses need a separate review workflow.",
          "items": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "focus": {
          "$ref": "#/$defs/reference_focus"
        }
      },
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "Each participant’s reading",
            "Local task question",
            "Selected dialogue turns",
            "Selected expressions",
            "Selection / exclusion reason",
            "Task consequences",
            "Why this judgment? Prefix evidence only",
            "blocking_uncertainty",
            "evidence_verified",
            "focal_pair",
            "focus_quotes",
            "focus_source_ids",
            "include_in_pilot",
            "inclusion_or_exclusion_reason",
            "local_question",
            "participant_meanings_with_source_quotes",
            "prefix_only_rationale",
            "provisional_label",
            "review_metadata",
            "review_status",
            "reviewer_id",
            "task_outputs"
          ]
        }
      }
    },
    "focus_quote": {
      "type": "object",
      "required": [
        "Source turn",
        "Exact expression"
      ],
      "properties": {
        "Source turn": {
          "type": "string",
          "minLength": 1
        },
        "Speaker": {
          "type": "string"
        },
        "Exact expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "source_id",
            "speaker",
            "quote"
          ]
        }
      }
    },
    "evidence_quote": {
      "type": "object",
      "required": [
        "Evidence source",
        "Exact evidence"
      ],
      "properties": {
        "Evidence source": {
          "type": "string",
          "minLength": 1
        },
        "Speaker": {
          "type": "string"
        },
        "Exact evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "source_id",
            "speaker",
            "quote"
          ]
        }
      }
    },
    "review_snapshot": {
      "type": "object",
      "properties": {
        "Review status": {
          "enum": [
            "unreviewed",
            "in_progress",
            "reviewed",
            "completed"
          ]
        },
        "Reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "Reviewer and exposure": {
          "$ref": "#/$defs/metadata"
        },
        "Participants being compared": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "Could uncertainty change the conclusion?": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "Review judgment": {
          "enum": [
            "ALIGNED",
            "POTENTIAL_MISMATCH",
            "UNRESOLVED",
            null
          ]
        },
        "Evidence checked?": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "Include in pilot?": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "participant_interpretations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meaning"
          }
        },
        "consequence_analysis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "Evidence tier": {
                  "const": "S"
                },
                "Supported consequences JSON": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "array"
                  },
                  "description": "Optional canonical F6 values keyed by actual participant IDs, for the same task/event. The checker never infers these sets from prose."
                },
                "Same task / event scope": {},
                "Consequences by participant": {},
                "Comparison in words": {},
                "What is still unknown? One reason per line": {},
                "Evidence check notes": {},
                "Consequence format notes": {},
                "Implementation limits": {},
                "Computation status": {},
                "Preparation notes": {}
              },
              "additionalProperties": true,
              "propertyNames": {
                "not": {
                  "enum": [
                    "evidence_tier",
                    "scope",
                    "participant_outputs",
                    "comparison",
                    "blocking_reasons",
                    "supported_consequences",
                    "verification_note",
                    "consequence_encoding_note",
                    "implementation_limits",
                    "computation_status",
                    "authorship"
                  ]
                }
              }
            }
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtask_hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "description": "Exactly one current local task question; null description is a pending question. Multiple human task hypotheses need a separate review workflow.",
          "items": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "focus": {
          "$ref": "#/$defs/reference_focus"
        }
      },
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "Each participant’s reading",
            "Local task question",
            "Selected dialogue turns",
            "Selected expressions",
            "Selection / exclusion reason",
            "Task consequences",
            "Why this judgment? Prefix evidence only",
            "blocking_uncertainty",
            "evidence_verified",
            "focal_pair",
            "focus_quotes",
            "focus_source_ids",
            "include_in_pilot",
            "inclusion_or_exclusion_reason",
            "local_question",
            "participant_meanings_with_source_quotes",
            "prefix_only_rationale",
            "provisional_label",
            "review_metadata",
            "review_status",
            "reviewer_id",
            "task_outputs"
          ]
        }
      }
    },
    "reference_quote": {
      "type": "object",
      "required": [
        "utterance_id",
        "quote"
      ],
      "properties": {
        "utterance_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "propertyNames": {
        "not": {
          "enum": [
            "source_id",
            "Source turn",
            "Exact expression",
            "Speaker"
          ]
        }
      },
      "description": "An additional exact selected quotation. Preserve order and any optional quote properties."
    },
    "reference_focus": {
      "type": "object",
      "required": [
        "utterance_id",
        "quote",
        "why_selected",
        "additional_quotes",
        "selected_utterance_ids"
      ],
      "properties": {
        "utterance_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "speaker": {
          "type": "string"
        },
        "why_selected": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional reason for choosing this expression. Null means not separately supplied; this is distinct from rationale and selection_reason."
        },
        "additional_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference_quote"
          }
        },
        "selected_utterance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "quote_metadata": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "source_id",
                "quote",
                "speaker"
              ]
            }
          },
          "description": "Optional original primary-quote properties, retained without conflating them with the focus-selection reason."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "utterance_id": {
                "type": "null"
              }
            },
            "required": [
              "utterance_id"
            ]
          },
          "then": {
            "properties": {
              "quote": {
                "type": "null"
              },
              "additional_quotes": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "speaker"
                  ]
                },
                {
                  "required": [
                    "quote_metadata"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "minProperties": 1,
  "$comment": "Representation contract: schemas/reference_review_map.json. The earlier form-label and technical schemas are preserved separately. Observer inputs and model/adjudication contracts are unchanged.",
  "x-review-key-format": "CIM_REFERENCE_KEYS_V1"
}
