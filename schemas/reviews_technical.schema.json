{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tier S human reviews",
  "description": "Case-keyed human review records with exposure history. Structural validation does not certify semantics or independence. See review_tools.py for frozen-source checks.",
  "type": "object",
  "patternProperties": {
    "^[A-Za-z0-9_]+$": {
      "$ref": "#/$defs/review"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "quote": {
      "type": "object",
      "required": [
        "source_id",
        "quote"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "meaning": {
      "type": "object",
      "required": [
        "participant_id",
        "meaning",
        "source_quotes",
        "support"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "source_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "support": {
          "enum": [
            "supported",
            "possible",
            "unsupported",
            null
          ],
          "description": "Human assessment. Possible readings are not adopted readings. An exact quote alone does not prove support."
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_tier",
        "observer_input_sha256",
        "prior_exposure",
        "prefix_first_review_completed",
        "later_evidence_review_completed",
        "assistant_wording_fields",
        "human_content_confirmed"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "evidence_tier": {
          "const": "S"
        },
        "observer_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256 of the raw four-field observer_inputs JSON file, not the observer_cases wrapper."
        },
        "prior_exposure": {
          "type": "object",
          "required": [
            "assistant_draft",
            "system_outputs",
            "released_labels",
            "later_evidence",
            "notes"
          ],
          "properties": {
            "assistant_draft": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "system_outputs": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "released_labels": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "later_evidence": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "prefix_first_review_completed": {
          "type": "boolean"
        },
        "later_evidence_review_completed": {
          "type": "boolean"
        },
        "assistant_wording_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "human_content_confirmed": {
          "type": "boolean",
          "description": "True only after a human checks the current content; importing wording does not confirm it."
        },
        "first_pass_judgment_snapshot": {
          "type": "object",
          "description": "Optional frozen substantive first-pass record, saved once before later suggestion exposure."
        },
        "first_pass_judgment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256 of recursively key-sorted compact JSON of the first-pass snapshot, encoded UTF-8."
        },
        "wording_exposure_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before_prefix_first_review": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "description": "Append-only suggestion viewing/copy history. Later viewing requires an unchanged frozen first-pass snapshot to retain strict reference eligibility."
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": [
        "review_status",
        "reviewer_id",
        "review_metadata",
        "focal_pair",
        "local_question",
        "focus_source_ids",
        "focus_quotes",
        "participant_meanings_with_source_quotes",
        "task_outputs",
        "blocking_uncertainty",
        "provisional_label",
        "prefix_only_rationale",
        "evidence_verified",
        "include_in_pilot",
        "inclusion_or_exclusion_reason"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "unreviewed",
            "in_progress",
            "reviewed",
            "completed"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_metadata": {
          "$ref": "#/$defs/metadata"
        },
        "focal_pair": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "local_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "focus_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "focus_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "participant_meanings_with_source_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meaning"
          }
        },
        "task_outputs": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "evidence_tier": {
                  "const": "S"
                },
                "supported_consequences": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "array"
                  },
                  "description": "Optional canonical F6 values keyed by actual participant IDs, for the same task/event. The checker never infers these sets from prose."
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "blocking_uncertainty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "provisional_label": {
          "enum": [
            "ALIGNED",
            "POTENTIAL_MISMATCH",
            "UNRESOLVED",
            null
          ]
        },
        "prefix_only_rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "include_in_pilot": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "inclusion_or_exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "minProperties": 1
}
